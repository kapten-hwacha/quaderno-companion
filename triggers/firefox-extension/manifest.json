{
  "manifest_version": 2,
  "name": "Quaderno Companion",
  "version": "1.0.0",
  "description": "Send tabs, articles, and research papers directly to your Fujitsu Quaderno Gen 2 E-ink display.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Send to Quaderno"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "companion@quaderno.local"
    }
  }
}
