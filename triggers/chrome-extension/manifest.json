{
  "manifest_version": 3,
  "name": "Quaderno Companion",
  "version": "1.0.0",
  "description": "Send tabs, articles, and research papers directly to Fujitsu Quaderno Gen 2 E-ink display.",
  "permissions": [
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to Quaderno"
  }
}
